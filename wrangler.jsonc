{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindsoft-academy",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AcademyContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AcademyContainer",
        "name": "ACADEMY"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AcademyContainer"]
    }
  ]
}
