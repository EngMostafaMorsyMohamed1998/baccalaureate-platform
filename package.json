{
  "name": "baccalaureate-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/prisma-generate.mjs",
    "build": "node scripts/prisma-generate.mjs && node scripts/prisma-migrate.mjs && tsx scripts/check-questions.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "check:content": "tsx scripts/check-questions.ts",
    "books:fetch": "node scripts/fetch-books.mjs",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:seed": "npm run seed --prefix server"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@cloudflare/containers": "^0.0.30",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "arabic-persian-reshaper": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.1.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
